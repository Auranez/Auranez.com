<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Auranez AI Assistant</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#07070a;
  color:white;
  min-height:100vh;
}

.container{
  max-width:900px;
  margin:auto;
  padding:24px;
}

nav{
  height:80px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:18px;
  letter-spacing:5px;
  opacity:.85;
}

.back{
  color:white;
  text-decoration:none;
  border:1px solid #33333d;
  padding:10px 18px;
  border-radius:25px;
  font-size:14px;
}

.hero{
  text-align:center;
  padding:70px 0 40px;
}

.badge{
  display:inline-block;
  border:1px solid #3a3a45;
  border-radius:30px;
  padding:10px 18px;
  color:#a7a7b2;
  font-size:14px;
  margin-bottom:25px;
}

h1{
  font-size:clamp(42px,10vw,72px);
  margin:0 0 20px;
  background:linear-gradient(90deg,#ffffff,#aeb7ff);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.subtitle{
  font-size:22px;
  color:#a7a7b2;
  line-height:1.6;
  max-width:650px;
  margin:auto;
}

.assistant-box{
  margin:50px auto;
  max-width:750px;
  background:#101014;
  border:1px solid #292932;
  border-radius:28px;
  padding:25px;
}

textarea{
  width:100%;
  min-height:160px;
  resize:vertical;
  background:#07070a;
  border:1px solid #33333d;
  border-radius:20px;
  color:white;
  padding:18px;
  font-size:17px;
  outline:none;
  font-family:Arial,sans-serif;
}

textarea:focus{
  border-color:#77778a;
}

.actions{
  display:flex;
  gap:15px;
  margin-top:18px;
  flex-wrap:wrap;
}

button,
.home-button{
  display:inline-block;
  padding:15px 28px;
  border-radius:30px;
  font-size:16px;
  font-weight:bold;
  text-decoration:none;
  cursor:pointer;
}

button{
  border:0;
  background:white;
  color:#08080a;
}

.home-button{
  border:1px solid #3a3a45;
  color:white;
  background:transparent;
}

.response{
  margin-top:25px;
  padding:20px;
  border-radius:20px;
  background:#0b0b10;
  border:1px solid #24242c;
  color:#a7a7b2;
  line-height:1.6;
  display:none;
}

footer{
  text-align:center;
  color:#55555f;
  font-size:13px;
  padding:30px 0;
}

@media(max-width:700px){
  .container{
    padding:20px;
  }

  .hero{
    padding-top:50px;
  }

  .subtitle{
    font-size:18px;
  }

  .assistant-box{
    padding:18px;
  }

  .actions{
    flex-direction:column;
  }

  button,
  .home-button{
    width:100%;
    text-align:center;
  }
}
</style>
</head>

<body>

<div class="container">

<nav>
  <div class="logo">AURANEZ</div>
  <a class="back" href="index.html">← Home</a>
</nav>

<section class="hero">

  <div class="badge">AURANEZ AI ASSISTANT</div>

  <h1>How can I help?</h1>

  <div class="subtitle">
    Ask questions, generate ideas and explore what AI can do.
  </div>

</section>

<div class="assistant-box">

  <textarea id="question"
    placeholder="Write your question here..."></textarea>

  <div class="actions">

    <button onclick="askAI()">
      Ask Auranez AI
    </button>

    <a class="home-button" href="index.html">
      Back to Home
    </a>

  </div>

  <div class="response" id="response"></div>

</div>

<footer>
  Auranez AI · The future starts here.
</footer>

</div>

<script>
function askAI(){

  const question =
    document.getElementById("question").value.trim();

  const response =
    document.getElementById("response");

  if(!question){
    response.style.display="block";
    response.textContent=
      "Please write a question first.";
    return;
  }

  response.style.display="block";

  response.innerHTML=
    "<strong>Auranez AI</strong><br><br>" +
    "Your question has been received. " +
    "The AI engine will be connected here next.";
}
</script>

</body>
</html>