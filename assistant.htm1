<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Auranez AI Assistant</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #07070a;
  color: white;
  min-height: 100vh;
}

.container {
  max-width: 900px;
  margin: auto;
  padding: 60px 24px;
}

h1 {
  font-size: 48px;
  margin-bottom: 15px;
}

p {
  color: #aaa;
  font-size: 19px;
  line-height: 1.6;
}

.chat {
  margin-top: 40px;
  background: #111116;
  border: 1px solid #30303a;
  border-radius: 24px;
  padding: 25px;
}

textarea {
  width: 100%;
  min-height: 150px;
  padding: 18px;
  border-radius: 15px;
  border: 1px solid #444;
  background: #08080b;
  color: white;
  font-size: 18px;
  resize: vertical;
}

button {
  margin-top: 18px;
  padding: 15px 30px;
  border: 0;
  border-radius: 30px;
  background: white;
  color: black;
  font-size: 18px;
  font-weight: bold;
}

#response {
  margin-top: 25px;
  padding: 20px;
  border-radius: 15px;
  background: #18181e;
  color: #ddd;
  line-height: 1.6;
}
</style>
</head>

<body>

<div class="container">

<h1>Auranez AI Assistant</h1>

<p>
Your intelligent AI assistant for ideas, questions and everyday tasks.
</p>

<div class="chat">

<textarea id="question" placeholder="Ask Auranez AI anything..."></textarea>

<button onclick="askAI()">Ask Auranez AI</button>

<div id="response">
Your answer will appear here.
</div>

</div>

</div>

<script>
function askAI() {

  const question = document.getElementById("question").value;
  const response = document.getElementById("response");

  if (!question.trim()) {
    response.innerText = "Please enter a question.";
    return;
  }

  response.innerText =
    "Auranez AI received your question: " + question +
    "\n\nThe AI assistant connection will be added next.";

}
</script>

</body>
</html>